    <select id="queryMaxAllRecord" resultType="com.crlink.smartpark.device.entity.DayReading">
        SELECT
        a.device_id,
        a.reading_date,
        a.start_reading_num,
        a.end_reading_num,
        a.consumption,
        a.reading_date_time
        from dev_day_reading a
        inner join (select device_id, max(reading_date) mrd
        FROM dev_day_reading
        <where>
            <if test="start !=null">
                and reading_date &gt; #{start}
            </if>
            <if test="end !=null">
                and reading_date &lt;= #{end}
            </if>
        </where>
        group by device_id) b on a.device_id = b.device_id and a.reading_date = b.mrd;
    </select>
