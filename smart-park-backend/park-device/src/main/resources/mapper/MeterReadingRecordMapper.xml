    <select id="queryMaxRecord" resultType="com.crlink.smartpark.device.dto.MeterReadingDTO">
        SELECT a.meter_id,a.meter_reading,a.reading_time,a.corrected_reading
        FROM dev_meter_reading_everyday_record a
        WHERE a.reading_time = (SELECT max(reading_time)
        FROM dev_meter_reading_everyday_record b
        WHERE a.meter_id = b.meter_id
        <if test="start !=null">
            and b.reading_time &gt; #{start}
        </if>
        <if test="end !=null">
            and b.reading_time &lt; #{end}
        </if>
        <if test="meterIds!=null and meterIds.size()>0">
            and b.meter_id in
            <foreach collection="meterIds" open="(" separator="," close=")" item="meterId">
                #{meterId}
            </foreach>
        </if>
        GROUP BY b.meter_id
        )
    </select>

    <select id="queryMinRecord" resultType="com.crlink.smartpark.device.dto.MeterReadingDTO">
        SELECT a.meter_id,a.meter_reading,a.reading_time,a.corrected_reading
        FROM dev_meter_reading_everyday_record a
        WHERE a.reading_time = (SELECT min(reading_time)
        FROM dev_meter_reading_everyday_record b
        WHERE a.meter_id = b.meter_id
        <if test="start !=null">
            and b.reading_time &gt; #{start}
        </if>
        <if test="end !=null">
            and b.reading_time &lt; #{end}
        </if>
        <if test="meterIds!=null and meterIds.size()>0">
            and b.meter_id in
            <foreach collection="meterIds" open="(" separator="," close=")" item="meterId">
                #{meterId}
            </foreach>
        </if>
        GROUP BY b.meter_id
        )
    </select>
