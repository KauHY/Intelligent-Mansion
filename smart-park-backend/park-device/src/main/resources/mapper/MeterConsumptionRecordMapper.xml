    <sql id="joinSelect">
        select m.`park_org_id`,
               m.`device_type`,
               JSON_EXTRACT(m.extension, '$.effectProperty') as effectProperty,
               JSON_EXTRACT(m.extension, '$.effectType')     as effectType,
               JSON_EXTRACT(m.extension, '$.meterType')      as meterType,
               JSON_EXTRACT(m.extension, '$.buildingId')     as buildingId,
               JSON_EXTRACT(m.extension, '$.houseIds')       as houseIds,
               JSON_EXTRACT(m.extension, '$.floors')         as floors,
               m.`device_name`,
               mr.`id`                                          id,
               mr.`meter_id`,
               mr.`settled_month`,
               mr.last_reading,
               mr.last_time,
               mr.`this_reading`,
               mr.`this_time`,
               mr.`consumption`,
               mr.`import_remark`
        from dev_device_info m
                 inner join dev_meter_consumption_record as mr on m.id = mr.meter_id
    </sql>

