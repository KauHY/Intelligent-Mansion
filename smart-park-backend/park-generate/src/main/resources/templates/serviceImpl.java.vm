import cn.hutool.core.collection.CollectionUtil;

import java.util.Collections;

import com.google.common.collect.Lists;


import java.util.*;
import java.util.function.Function;
import java.util.stream.Collectors;
import java.util.stream.Stream;


/**
 * $!{table.comment} 服务实现类
 *
 * @author ${author}
 * @since ${date}
 */
@Service
#if(${kotlin})
open class ${table.serviceImplName} : ${superServiceImplClass}<${table.mapperName}, ${entity}>(), ${table.serviceName} {

        }
#else
        public class ${table.serviceImplName} extends ${superServiceImplClass}<${table.mapperName}, ${entity}>implements ${table.serviceName} {

        @Override
        public Map<String,?>id2ValueMap(Collection<String>ids,SFunction<${entity},?>sValue){
        if(ObjectUtils.isEmpty(ids)){
        return Collections.emptyMap();
        }
        boolean flag=sValue!=null;
        LambdaQueryChainWrapper<${entity}>lambdaQuery=this.lambdaQuery().in(${entity}::getId,ids);
        if(flag){
        lambdaQuery.select(${entity}::getId,sValue);
        }
        Stream<${entity}>stream=lambdaQuery.list().parallelStream();
        Map<String,Object>result=null;
        if(flag){
        result=stream.collect(Collectors.toMap(${entity}::getId,sValue));
        }else{
        result=stream.collect(Collectors.toMap(${entity}::getId,Function.identity()));
        }
        return result;
        }
        /**
         * 保存或更新数据
         */
        @Override
        public Boolean saveOrUpdate${entity}(${entity}ReqDTO reqDTO){
    ${entity} entity=MyBeanUtils.copy(reqDTO, ${entity}::new);
        EntityUserUtil.setAllDynamic(entity);
        return this.saveOrUpdate(entity);
        }

        /**
         * 通过id查询实体
         *
         */
        @Override
        public ${entity}DTO get${entity}ById(String id){
    ${entity} entity=Optional.ofNullable(getById(id)).orElseThrow(()->new ResolinkRuntimeException("100071"));
        return entitiesToDTOs(Lists.newArrayList(entity)).get(0);
        }

        /**
         * 分页查询
         *
         * @return 分页结果
         */
        @Override
        public PageInfo<${entity}DTO>list${entity}Page(${entity}Query query){
        query.startPage();
        List<${entity}>list=null;
        MyPageInfoUtils.isEmptyPage(list);
        List<${entity}DTO>result=entitiesToDTOs(list);
        return query.createPageInfo(result);
        }

        /**
         * 封装查询条件
         *
         * @return 查询条件
         */
        private LambdaQueryWrapper<${entity}>getConditionWrapper(${entity}Query query){
        LambdaQueryWrapper<${entity}>queryWrapper=new LambdaQueryWrapper<${entity}>();
        return queryWrapper;
        }

        /***
         * entity转DTO
         * @return DTO集合
         */
        private List<${entity}DTO>entitiesToDTOs(List<${entity}>entities){
        return MyBeanUtils.copyList(entities,${entity}DTO::new,(s,t)->{

        });
        }
        }
#end
