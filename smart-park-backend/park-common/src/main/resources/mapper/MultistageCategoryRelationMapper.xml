<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crlink.smartpark.common.mapper.MultistageCategoryRelationMapper">

    <select id="listBusinessToNCategoryRelation" resultType="com.crlink.smartpark.common.dto.MultistageCategoryRelationDTO"
            parameterType="com.crlink.smartpark.common.dto.MultistageCategoryRelationQueryDTO">
        SELECT cmcr.id, cmcr.business_id,
        <choose>
            <when test="categoryId == null or categoryId == ''">
                GROUP_CONCAT(cmcr.category_id)
            </when>
            <otherwise>
                cmcr.category_id
            </otherwise>
        </choose>
        AS categoryId
        FROM com_multistage_category_relation cmcr
        <where>
            cmcr.deleted = 0
            <if test="categoryId != null and categoryId != ''">
                AND cmcr.category_id = #{categoryId}
            </if>
            <if test="businessId != null and businessId != ''">
                AND cmcr.business_id = #{businessId}
            </if>
            <if test="parkOrgId != null and parkOrgId != ''">
                AND cmcr.park_org_id = #{parkOrgId}
            </if>
        </where>
        <if test="categoryId == null or categoryId == ''">
            GROUP BY cmcr.business_id
        </if>
    </select>
</mapper>
