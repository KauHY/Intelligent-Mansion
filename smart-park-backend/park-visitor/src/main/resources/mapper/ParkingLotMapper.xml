<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crlink.smartpark.visitor.mapper.ParkingLotMapper">

    <delete id="deleteByParkOrgId">
        DELETE FROM vis_parking_lot WHERE id IN <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach> OR
        <choose>
            <when test="parkOrgIds.size() == 0">
                park_org_id IS NULL OR park_org_id=''
            </when>
            <otherwise>
                park_org_id IN <foreach collection="parkOrgIds" item="id" open="(" close=")" separator=",">#{id}</foreach>
            </otherwise>
        </choose>
    </delete>

</mapper>
