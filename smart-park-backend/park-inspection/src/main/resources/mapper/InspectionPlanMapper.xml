<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crlink.smartpark.inspection.mapper.InspectionPlanMapper">

    <select id="queryCircuitByPlanId"
            resultMap="planCircuitEntity">
        select
        p.id planId,
        c.id circuitId,
        c.circuit_name,
        c.orderly orderly
        from ins_inspection_plan p
        left join ins_inspection_circuit c
        on p.circuit_id= c.id and c.deleted=0 and
        p.id in
        <foreach collection="planIds" item="planId" open="(" close=")" separator=",">
            #{planId}
        </foreach>
    </select>
    <resultMap id="planCircuitEntity" type="com.crlink.smartpark.inspection.dto.resultmap.PlanCircuitEntity"
               autoMapping="true"></resultMap>
</mapper>
