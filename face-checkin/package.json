{
  "name": "vue-template",
  "version": "1.0.0",
  "description": "vue3.x+webpack",
  "main": "./src/main.js",
  "scripts": {
    "dev": "dog-cli start",
    "dev:proxy": "cross-env --max_old_space_size=8192 ENV_MODE=dev webpack serve --config ./build/webpack.dev.conf",
    "dev:mock": "cross-env  mock=true ENV_MODE=dev webpack serve --config ./build/webpack.dev.conf",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ENV_MODE=prod webpack --config ./build/webpack.prod.conf",
    "build:sit": "cross-env ENV_MODE=sit webpack --config ./build/webpack.prod.conf",
    "dll": "webpack --config ./build/webpack.dll.js",
    "fix-memory-limit": "cross-env LIMIT=8192 increase-memory-limit",
    "lint:eslint": "cross-env ENV_MODE=prod eslint --fix --ext .ts,.js,.vue ./src/",
    "lint:stylelint": "cross-env ENV_MODE=prod stylelint --fix \"./src/**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "prepare": "husky install",
    "commit": "dog-cli commit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "ts": "tsc --noEmit"
  },
  "keywords": [
    "vue3.x"
  ],
  "author": "guochao82",
  "license": "ISC",
  "devDependencies": {
